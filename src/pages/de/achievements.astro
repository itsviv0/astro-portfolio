---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { ArrowRight, Calendar, Award } from "lucide-react";
import certifications from "../../data/certifications.js";
import achievements from "../../data/achievements-de.js";
import { ExternalLink } from "lucide-react";
import { useTranslations } from "../../i18n/index.js";

const t = useTranslations("de");
---

<Layout title="Erfolge - Vivek Sindagi">
  <Navigation />

  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-br from-primary-50 to-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-fade-in">
            Erfolge & Zertifizierungen
          </h1>
          <p class="text-xl text-gray-600 mb-8 animate-slide-up">
            Professionelle Zertifizierungen, Erfolge und Erkenntnisse aus meiner
            Reise in der Softwareentwicklung und dem Datenengineering
          </p>
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl font-bold mb-12 text-center">
            Professionelle Zertifizierungen
          </h2>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
              certifications.map((cert, index) => (
                <div
                  class="certification-card"
                  style={`animation-delay: ${index * 0.1}s`}
                >
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex-1">
                      <div class="flex items-center gap-2">
                        <h3 class="text-lg hover:text-tertiary-700 font-medium transition-colors">
                          {cert.title}
                        </h3>
                        <a
                          href={cert.link}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          <ExternalLink className="w-4 h-4" />
                        </a>
                      </div>
                      <p class="text-primary-600 font-medium mb-1">
                        {cert.issuer}
                      </p>
                      <p class="text-sm text-gray-500">
                        Ausgestellt {cert.date}
                      </p>
                    </div>
                  </div>

                  {cert.skills && cert.skills.length > 0 && (
                    <div class="mb-4">
                      <p class="text-xs text-gray-600 mb-2 font-medium">
                        Fähigkeiten:
                      </p>
                      <div class="flex flex-wrap gap-1">
                        {cert.skills.map((skill) => (
                          <span class="text-xs bg-gray-100 text-gray-700 px-2 py-1 rounded-full">
                            {skill}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Achievements Section -->
    <section class="py-20 bg-gradient-to-br from-gray-50 to-gray-100 relative">
      <!-- Background decoration -->
      <div
        class="absolute top-10 left-10 w-64 h-64 bg-primary-100 rounded-full blur-3xl opacity-20"
      >
      </div>
      <div
        class="absolute bottom-10 right-10 w-80 h-80 bg-blue-100 rounded-full blur-3xl opacity-15"
      >
      </div>

      <div class="container mx-auto px-6 lg:px-8 relative">
        <div class="text-center mb-12">
          <div
            class="inline-flex items-center bg-white/80 backdrop-blur-sm text-gray-700 px-4 py-2 rounded-full text-sm font-medium mb-6 shadow-sm"
          >
            <span class="w-2 h-2 bg-green-500 rounded-full mr-2 animate-pulse"
            ></span>
            Frische Inhalte
          </div>
          <h2
            class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-6"
          >
            {t("achievements.title")}
          </h2>
          <p
            class="text-gray-600 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed"
          >
            {t("achievements.subtitle")}
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-8 lg:gap-10">
          {
            achievements.map((achievement, index) => (
              <article
                class="blog-card group"
                style={`animation-delay: ${index * 0.15}s`}
              >
                <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
                  <div class="flex items-center gap-1">
                    <Calendar className="w-4 h-4" />
                    {new Date(achievement.date).toLocaleDateString("de-DE", {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })}
                  </div>
                  <span class="text-primary-600 font-medium">
                    {achievement.readTime}
                  </span>
                </div>

                <h3 class="text-xl font-bold mb-4 group-hover:text-primary-600 transition-colors">
                  {achievement.title}
                </h3>

                <p class="text-gray-600 mb-6 flex-1">{achievement.excerpt}</p>

                <div class="flex flex-wrap gap-2 mb-6">
                  {achievement.tags.map((tag) => (
                    <span class="px-3 py-1 bg-primary-50 text-primary-700 rounded-full text-sm font-medium">
                      {tag}
                    </span>
                  ))}
                </div>

                <a
                  href={achievement.link}
                  class="text-primary-600 font-semibold hover:text-primary-700 transition-colors inline-flex items-center group/link mt-auto"
                >
                  Mehr lesen
                  <ArrowRight className="w-4 h-4 ml-1 group-hover/link:translate-x-1 transition-transform" />
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .certification-card {
    @apply bg-white p-6 rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300 animate-slide-up flex flex-col h-full;
  }

  .blog-card {
    @apply bg-white/80 backdrop-blur-sm p-6 lg:p-8 rounded-2xl shadow-sm hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-500 border border-gray-200/50 hover:border-primary-200 animate-slide-up transform hover:-translate-y-2 flex flex-col;
  }

  .featured-post {
    @apply bg-gradient-to-r from-primary-50 to-gray-50 p-8 rounded-xl border border-primary-200;
  }

  .blog-post {
    @apply bg-white p-6 rounded-xl shadow-sm border border-gray-200 hover:shadow-md transition-all duration-300 animate-slide-up;
  }

  .tag-filter {
    @apply px-4 py-2 rounded-full border border-gray-300 text-gray-700 hover:border-primary-600 hover:text-primary-600 transition-all font-medium text-sm;
  }

  .tag-filter.active {
    @apply bg-primary-600 text-white border-primary-600;
  }

  .btn-primary {
    @apply bg-primary-600 text-white px-6 py-3 rounded-lg hover:bg-primary-700 transition-colors font-medium inline-flex items-center;
  }
</style>
