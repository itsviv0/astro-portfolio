---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import timeline from "../../data/experience.js";
import { useTranslations } from "../../i18n/index.js";

const t = useTranslations("en");
---

<Layout title="About - Vivek Sindagi">
  <Navigation />

  <main class="pt-24 pb-16">
    <!-- Story Timeline -->
    <section class="py-8 bg-white">
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2
            class="text-2xl md:text-3xl font-display font-bold mb-16 text-center"
          >
            {t("timeline.experience")}
          </h2>

          <div class="relative">
            <!-- Timeline line -->
            <div
              class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary-200 via-primary-300 to-primary-200"
            >
            </div>

            <div class="space-y-16">
              {
                timeline.map((item, index) => (
                  <div
                    class="relative animate-slide-up"
                    style={`animation-delay: ${index * 0.15}s`}
                  >
                    <div class="absolute left-6 w-4 h-4 bg-primary-600 rounded-full border-4 border-white shadow-lg z-10" />

                    <div class="ml-20">
                      <div class="bg-white rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300">
                        <div class="flex flex-col md:flex-row md:items-center gap-4 mb-6">
                          <div class="flex items-center gap-3">
                            <span class="text-2xl">{item.emoji}</span>
                            <h3 class="text-xl font-bold text-gray-900">
                              {item.title}
                            </h3>
                          </div>
                          <div class="md:ml-auto">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-primary-50 text-primary-700">
                              {item.period}
                            </span>
                          </div>
                        </div>

                        <p class="text-gray-600 leading-relaxed mb-6">
                          {item.description}
                        </p>

                        <div class="flex flex-wrap gap-2">
                          {item.skills.map((skill) => (
                            <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium">
                              {skill}
                            </span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
