---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { ArrowRight, Calendar, Award } from "lucide-react";
import certifications from "../../data/certifications.js";
import achievements from "../../data/achievements.js";
import { ExternalLink } from "lucide-react";
import { useTranslations } from '../../i18n/index.js';

const t = useTranslations('en');
---

<Layout title="Achievements - Vivek Sindagi">
  <Navigation />

  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="py-16 bg-gradient-to-br from-primary-50 to-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6 animate-fade-in">
            Achievements & Certifications
          </h1>
          <p class="text-xl text-gray-600 mb-8 animate-slide-up">
            Professional certifications, accomplishments, and insights from my
            journey in software development and data engineering
          </p>
        </div>
      </div>
    </section>

    <!-- Certifications Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">
              Certifications
            </h2>
            <p class="text-gray-600 text-lg max-w-3xl mx-auto">
              Continuous learning through industry-recognized certifications
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
              certifications.map((cert, index) => (
                <div
                  class="certification-card group"
                  style={`animation-delay: ${index * 0.1}s`}
                >
                  <div class="flex items-start gap-4 mb-4">
                    <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-600 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                      <Award className="w-8 h-8 text-white" />
                    </div>
                    <div class="flex-1">
                      <h3 class="font-bold text-lg mb-1 group-hover:text-primary-600 transition-colors">
                        {cert.title}
                      </h3>
                      <p class="text-gray-600 text-sm">{cert.issuer}</p>
                      <p class="text-primary-600 text-sm font-medium">{cert.date}</p>
                    </div>
                  </div>
                  <p class="text-gray-700 mb-6 line-clamp-3">
                    {cert.description || `Professional certification in ${cert.skills.join(', ')}`}
                  </p>
                  <div class="flex flex-wrap gap-2 mb-6">
                    {cert.skills.map((skill) => (
                      <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-lg text-sm">
                        {skill}
                      </span>
                    ))}
                  </div>
                  <a
                    href={cert.link}
                    class="btn-primary inline-flex items-center group/link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View Certificate
                    <ExternalLink className="w-4 h-4 ml-2 group-hover/link:translate-x-1 transition-transform" />
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Blog/Achievements Section -->
    <section class="py-16 bg-gradient-to-br from-gray-50 to-gray-100">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">
              {t('achievements.title')}
            </h2>
            <p class="text-gray-600 text-lg">
              {t('achievements.subtitle')}
            </p>
          </div>

          <div class="space-y-8">
            {
              achievements.map((achievement, index) => (
                <article
                  class="blog-card group"
                  style={`animation-delay: ${index * 0.15}s`}
                >
                  <div class="flex flex-col lg:flex-row gap-8">
                    <div class="flex-1">
                      <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
                        <div class="flex items-center gap-1">
                          <Calendar className="w-4 h-4" />
                          {new Date(achievement.date).toLocaleDateString("en-US", {
                            month: "short",
                            day: "numeric",
                            year: "numeric",
                          })}
                        </div>
                        <span class="text-primary-600 font-medium">{achievement.readTime}</span>
                      </div>
                      
                      <h3 class="text-2xl font-bold mb-4 group-hover:text-primary-600 transition-colors">
                        {achievement.title}
                      </h3>
                      
                      <p class="text-gray-700 mb-6 text-lg leading-relaxed">
                        {achievement.excerpt}
                      </p>
                      
                      <div class="flex flex-wrap gap-2 mb-6">
                        {achievement.tags.map((tag) => (
                          <span class="px-3 py-1 bg-white/80 backdrop-blur-sm text-primary-700 rounded-lg text-sm font-medium border border-primary-200">
                            {tag}
                          </span>
                        ))}
                      </div>
                      
                      <a
                        href={achievement.link}
                        class="text-primary-600 font-semibold hover:text-primary-700 transition-colors inline-flex items-center group/link"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        Read More
                        <ArrowRight className="w-4 h-4 ml-1 group-hover/link:translate-x-1 transition-transform" />
                      </a>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .certification-card {
    @apply bg-white p-6 rounded-2xl shadow-sm hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-500 border border-gray-100 hover:border-primary-200 animate-slide-up transform hover:-translate-y-2;
  }

  .blog-card {
    @apply bg-white/90 backdrop-blur-sm p-8 rounded-2xl shadow-sm hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-500 border border-gray-200/50 hover:border-primary-200 animate-slide-up transform hover:-translate-y-2;
  }

  .btn-primary {
    @apply bg-primary-600 text-white px-6 py-3 rounded-xl hover:bg-primary-700 hover:shadow-lg hover:shadow-primary-600/25 transition-all duration-300 font-semibold;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
