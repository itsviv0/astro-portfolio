---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Code, Database, Users, Zap } from 'lucide-react';
---

<Layout title="About - Vivek G Sindagi">
  <Navigation />
  
  <main class="pt-24 pb-16">
    <!-- Hero Section -->
    <section class="py-20 bg-gradient-to-br from-primary-50 via-white to-gray-50 relative overflow-hidden">
      <!-- Background decoration -->
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="absolute top-20 right-10 w-72 h-72 bg-primary-100 rounded-full blur-3xl opacity-20"></div>
      
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center bg-primary-50 text-primary-700 px-4 py-2 rounded-full text-sm font-medium mb-8 animate-bounce-subtle">
            <span class="w-2 h-2 bg-primary-500 rounded-full mr-2"></span>
            My Story
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold mb-8 animate-fade-in">
            About Me
          </h1>
          <p class="text-xl md:text-2xl text-gray-600 mb-8 animate-slide-up leading-relaxed">
            A journey from curiosity to creating impactful solutions
          </p>
        </div>
      </div>
    </section>
    
    <!-- Story Timeline -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-display font-bold mb-16 text-center">My Journey</h2>
          
          <div class="relative">
            <!-- Timeline line -->
            <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary-200 via-primary-300 to-primary-200"></div>
            
            <div class="space-y-16">
              <div class="timeline-item">
                <div class="timeline-marker">🎯</div>
                <div class="timeline-content">
                  <h3 class="text-2xl font-bold mb-3 text-gray-900">Product-Led Growth (2025)</h3>
                  <p class="text-gray-600 mb-6 text-lg leading-relaxed">
                    Currently focusing on building data-driven products that scale. Working on advanced analytics platforms 
                    and real-time processing systems that handle millions of events daily.
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <span class="skill-tag">Python</span>
                    <span class="skill-tag">Apache Spark</span>
                    <span class="skill-tag">React</span>
                    <span class="skill-tag">TypeScript</span>
                  </div>
                </div>
              </div>
              
              <div class="timeline-item">
                <div class="timeline-marker">💼</div>
                <div class="timeline-content">
                  <h3 class="text-2xl font-bold mb-3 text-gray-900">Data Engineering Intern - TechCorp (2024)</h3>
                  <p class="text-gray-600 mb-6 text-lg leading-relaxed">
                    Designed and implemented ETL pipelines that reduced data processing time by 40%. 
                    Built monitoring dashboards and automated testing frameworks for data quality assurance.
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <span class="skill-tag">Airflow</span>
                    <span class="skill-tag">PostgreSQL</span>
                    <span class="skill-tag">Docker</span>
                    <span class="skill-tag">AWS</span>
                  </div>
                </div>
              </div>
              
              <div class="timeline-item">
                <div class="timeline-marker">🚀</div>
                <div class="timeline-content">
                  <h3 class="text-2xl font-bold mb-3 text-gray-900">The Dev Journey Begins (2022)</h3>
                  <p class="text-gray-600 mb-6 text-lg leading-relaxed">
                    Started my coding journey with a deep dive into full-stack development. 
                    Built my first major project - a task management app that taught me the fundamentals 
                    of both frontend and backend development.
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <span class="skill-tag">JavaScript</span>
                    <span class="skill-tag">Node.js</span>
                    <span class="skill-tag">MongoDB</span>
                    <span class="skill-tag">HTML/CSS</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Philosophy Section -->
    <section class="py-20 bg-gradient-to-br from-gray-50 to-gray-100">
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-display font-bold mb-16 text-center">Developer Philosophy</h2>
          
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
            <div class="philosophy-card">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
                <Code className="w-6 h-6 text-primary-600" />
              </div>
              <h3 class="text-xl font-bold mb-4 text-gray-900">Clean & Maintainable Code</h3>
              <p class="text-gray-600 leading-relaxed">
                I believe in writing code that tells a story. Every function, variable, and comment should 
                contribute to a clear narrative that future developers (including myself) can easily follow.
              </p>
            </div>
            
            <div class="philosophy-card">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
                <Database className="w-6 h-6 text-primary-600" />
              </div>
              <h3 class="text-xl font-bold mb-4 text-gray-900">Data-Driven Decisions</h3>
              <p class="text-gray-600 leading-relaxed">
                Every architectural choice and optimization is backed by metrics. I use tools like Hotjar 
                and Google Analytics to understand user behavior and make informed improvements.
              </p>
            </div>
            
            <div class="philosophy-card">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
                <Users className="w-6 h-6 text-primary-600" />
              </div>
              <h3 class="text-xl font-bold mb-4 text-gray-900">Collaboration First</h3>
              <p class="text-gray-600 leading-relaxed">
                Great software is built by teams, not individuals. I prioritize clear communication, 
                thorough documentation, and knowledge sharing to help teams move fast together.
              </p>
            </div>
            
            <div class="philosophy-card">
              <div class="w-12 h-12 bg-primary-100 rounded-xl flex items-center justify-center mb-6">
                <Zap className="w-6 h-6 text-primary-600" />
              </div>
              <h3 class="text-xl font-bold mb-4 text-gray-900">Ship Fast, Learn Faster</h3>
              <p class="text-gray-600 leading-relaxed">
                I believe in rapid iteration and continuous learning. Build MVPs, gather feedback, 
                and iterate based on real user needs rather than assumptions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Experimentation Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl md:text-4xl font-display font-bold mb-16 text-center">Experimentation & Iteration</h2>
          
          <div class="space-y-10">
            <div class="experiment-card">
              <h3 class="text-xl font-bold mb-4 text-gray-900">Chart Library Performance Optimization</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">
                Swapped from Chart.js to D3.js for a high-frequency trading dashboard, resulting in 
                60% faster rendering times and smoother animations for real-time data updates.
              </p>
              <div class="flex items-center gap-4 text-sm">
                <span class="bg-red-50 text-red-700 px-3 py-1 rounded-full font-medium">Before: 150ms render time</span>
                <span class="text-gray-400">→</span>
                <span class="bg-green-50 text-green-700 px-3 py-1 rounded-full font-medium">After: 60ms render time</span>
              </div>
            </div>
            
            <div class="experiment-card">
              <h3 class="text-xl font-bold mb-4 text-gray-900">User Interface Optimization</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">
                Used Hotjar heatmaps to identify pain points in our admin dashboard. Moved frequently 
                used actions to the top navigation, reducing average task completion time by 25%.
              </p>
              <div class="flex items-center gap-4 text-sm">
                <span class="bg-orange-50 text-orange-700 px-3 py-1 rounded-full font-medium">User satisfaction: 3.2/5</span>
                <span class="text-gray-400">→</span>
                <span class="bg-green-50 text-green-700 px-3 py-1 rounded-full font-medium">User satisfaction: 4.1/5</span>
              </div>
            </div>
            
            <div class="experiment-card">
              <h3 class="text-xl font-bold mb-4 text-gray-900">Internal Tooling for Productivity</h3>
              <p class="text-gray-600 mb-6 leading-relaxed">
                Built a custom CLI tool that automated repetitive database migrations and deployments, 
                saving the team 2 hours per week and reducing human error in production releases.
              </p>
              <div class="flex items-center gap-4 text-sm">
                <span class="bg-red-50 text-red-700 px-3 py-1 rounded-full font-medium">Manual process: 30 min</span>
                <span class="text-gray-400">→</span>
                <span class="bg-green-50 text-green-700 px-3 py-1 rounded-full font-medium">Automated: 2 min</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .timeline-item {
    @apply relative flex items-start gap-8 animate-slide-up;
  }
  
  .timeline-marker {
    @apply w-16 h-16 rounded-full bg-gradient-to-br from-primary-100 to-primary-200 flex items-center justify-center text-2xl font-bold flex-shrink-0 relative z-10 shadow-lg;
  }
  
  .timeline-content {
    @apply flex-1 pb-12;
  }
  
  .skill-tag {
    @apply text-sm bg-primary-50 text-primary-700 px-3 py-1.5 rounded-full font-medium hover:bg-primary-100 transition-colors;
  }
  
  .philosophy-card {
    @apply bg-white p-8 rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg hover:shadow-gray-200/50 transition-all duration-500 animate-scale-in transform hover:-translate-y-1;
  }
  
  .experiment-card {
    @apply bg-gradient-to-br from-gray-50 to-gray-100 p-8 rounded-2xl border border-gray-200 hover:border-primary-200 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1;
  }
  
  .bg-grid-pattern {
    background-image: radial-gradient(circle, #e5e7eb 1px, transparent 1px);
    background-size: 20px 20px;
  }
</style>