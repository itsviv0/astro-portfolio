---
import { ArrowRight, Calendar, Clock } from 'lucide-react';

const posts = [
  {
    title: "My Journey with Apache Airflow",
    excerpt: "Lessons learned from building production-ready data pipelines and orchestrating complex workflows.",
    date: "2024-12-15",
    readTime: "5 min read",
    tags: ["Data Engineering", "Python", "Airflow"],
    link: "/blog/airflow-journey"
  },
  {
    title: "Optimizing React UI with Skeleton Loaders",
    excerpt: "How implementing skeleton screens improved perceived performance and user experience metrics.",
    date: "2024-12-10",
    readTime: "4 min read",
    tags: ["React", "Performance", "UX"],
    link: "/blog/skeleton-loaders"
  },
  {
    title: "Building Scalable APIs with Node.js",
    excerpt: "Best practices for designing REST APIs that can handle growth and maintain performance.",
    date: "2024-12-05",
    readTime: "6 min read",
    tags: ["Node.js", "API Design", "Backend"],
    link: "/blog/scalable-apis"
  }
];
---

<section class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Latest Insights</h2>
      <p class="text-gray-600 max-w-2xl mx-auto">
        Thoughts on software development, data engineering, and lessons learned from building production systems
      </p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-8">
      {posts.map((post, index) => (
        <article class="blog-card" style={`animation-delay: ${index * 0.1}s`}>
          <div class="flex items-center gap-4 text-sm text-gray-500 mb-3">
            <div class="flex items-center gap-1">
              <Calendar className="w-4 h-4" />
              {new Date(post.date).toLocaleDateString('en-US', { 
                month: 'short', 
                day: 'numeric', 
                year: 'numeric' 
              })}
            </div>
            <div class="flex items-center gap-1">
              <Clock className="w-4 h-4" />
              {post.readTime}
            </div>
          </div>
          
          <h3 class="text-xl font-bold mb-3 hover:text-primary-600 transition-colors">
            <a href={post.link}>{post.title}</a>
          </h3>
          
          <p class="text-gray-600 mb-4">{post.excerpt}</p>
          
          <div class="flex flex-wrap gap-2 mb-4">
            {post.tags.map((tag) => (
              <span class="text-xs bg-primary-50 text-primary-700 px-2 py-1 rounded-full">
                {tag}
              </span>
            ))}
          </div>
          
          <a href={post.link} class="text-primary-600 font-medium hover:text-primary-700 transition-colors inline-flex items-center">
            Read More
            <ArrowRight className="w-4 h-4 ml-1" />
          </a>
        </article>
      ))}
    </div>
    
    <div class="text-center mt-12">
      <a href="/blog" class="btn-secondary-large">
        View All Posts
        <ArrowRight className="w-5 h-5 ml-2" />
      </a>
    </div>
  </div>
</section>

<style>
  .blog-card {
    @apply bg-white p-6 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 hover:border-primary-200 animate-slide-up;
  }
  
  .btn-secondary-large {
    @apply border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-lg hover:border-primary-600 hover:text-primary-600 transition-all font-medium text-lg inline-flex items-center;
  }
</style>