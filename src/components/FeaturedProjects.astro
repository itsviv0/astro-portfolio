---
import { ArrowRight, Github, ExternalLink } from "lucide-react";
import { getLangFromUrl, useTranslations } from "../i18n/index.js";
import projects from "../data/projects.js";
import projectsDE from "../data/projects-de.js";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentProjects = lang === "de" ? projectsDE : projects;
const featuredProjects = currentProjects.filter((project) => project.featured);
---

<section class="py-16 bg-white">
  <div class="container mx-auto px-6 lg:px-8">
    <div class="text-center mb-12">
      <div
        class="inline-flex items-center bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-sm font-medium mb-6"
      >
        <span class="w-2 h-2 bg-primary-500 rounded-full mr-2"></span>
        Portfolio Highlights
      </div>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold mb-6">
        {t("projects.title")}
      </h2>
      <p
        class="text-gray-600 text-lg md:text-xl max-w-3xl mx-auto leading-relaxed"
      >
        {t("projects.subtitle")}
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8 lg:gap-10">
      {
        featuredProjects.map((project, index) => (
          <div
            class="project-card group"
            style={`animation-delay: ${index * 0.15}s`}
          >
            <div class="relative overflow-hidden rounded-xl mb-6 bg-gradient-to-br from-gray-100 to-gray-200">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-56 lg:h-64 object-cover group-hover:scale-110 transition-all duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-300" />
              <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
                <div class="bg-white/20 backdrop-blur-sm rounded-lg px-3 py-1">
                  <span class="text-white text-sm font-medium">
                    {project.impact}
                  </span>
                </div>
              </div>
              <div class="absolute bottom-4 left-4 right-4 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                <div class="flex gap-3">
                  <a href="#" class="btn-icon-white group/btn">
                    <Github className="w-5 h-5 group-hover/btn:scale-110 transition-transform" />
                  </a>
                  <a href="#" class="btn-icon-white group/btn">
                    <ExternalLink className="w-5 h-5 group-hover/btn:scale-110 transition-transform" />
                  </a>
                </div>
              </div>
            </div>

            <div class="mb-6">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-sm font-semibold text-primary-600 bg-primary-50 px-3 py-1.5 rounded-full">
                  {project.impact}
                </span>
              </div>
              <h3 class="text-xl lg:text-2xl font-bold mb-3 group-hover:text-primary-600 transition-colors leading-tight">
                {project.title}
              </h3>
              <p class="text-gray-600 leading-relaxed">{project.description}</p>
            </div>

            <div class="flex flex-wrap gap-2 mb-6">
              {project.stack.map((tech) => (
                <span class="text-sm bg-gray-100 text-gray-700 px-3 py-1.5 rounded-full font-medium hover:bg-primary-50 hover:text-primary-700 transition-colors">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="text-center mt-16">
      <a
        href={lang === "de" ? "/de/projects" : "/projects"}
        class="btn-secondary-large group"
      >
        {t("projects.viewAll")}
        <ArrowRight
          className="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
        />
      </a>
    </div>
  </div>
</section>

<style>
  .project-card {
    @apply bg-white p-6 lg:p-8 rounded-2xl shadow-sm hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-500 border border-gray-100 hover:border-primary-200 animate-slide-up transform hover:-translate-y-2 flex flex-col;
  }

  .btn-primary {
    @apply bg-primary-600 text-white px-6 py-3 rounded-xl hover:bg-primary-700 hover:shadow-lg hover:shadow-primary-600/25 transition-all duration-300 font-semibold inline-flex items-center justify-center;
  }

  .btn-icon-white {
    @apply bg-white/20 backdrop-blur-sm text-white p-3 rounded-xl hover:bg-white/30 transition-all duration-300 flex items-center justify-center;
  }

  .btn-secondary-large {
    @apply border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-xl hover:border-primary-600 hover:text-primary-600 hover:bg-primary-50 transition-all duration-300 font-semibold text-lg inline-flex items-center transform hover:scale-105;
  }
</style>
