---
import { ArrowRight, Download } from 'lucide-react';
---

<section class="pt-24 pb-16 bg-gradient-to-br from-gray-50 to-gray-100">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto text-center">
      <div class="animate-fade-in">
        <h1 class="text-5xl md:text-6xl font-bold mb-6">
          Hi, I'm <span class="text-primary-600">Vivek G Sindagi</span>
        </h1>
        <p class="text-xl md:text-2xl text-gray-600 mb-4">
          Software Developer based in Bengaluru
        </p>
        <p class="text-lg md:text-xl text-gray-700 mb-8 max-w-2xl mx-auto">
          I craft robust data pipelines, scalable backend systems, and thoughtful UIs that solve real-world problems.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/projects" class="btn-primary-large group">
            View My Work
            <ArrowRight className="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="/resume" class="btn-secondary-large">
            <Download className="w-5 h-5 mr-2" />
            Download Resume
          </a>
        </div>
      </div>
      
      <!-- Credibility Section -->
      <div class="animate-slide-up">
        <p class="text-gray-600 mb-6">Trusted by teams at</p>
        <div class="flex flex-wrap justify-center items-center gap-8 opacity-60">
          <div class="company-logo">
            <span class="text-2xl font-bold text-gray-700">TechCorp</span>
          </div>
          <div class="company-logo">
            <span class="text-2xl font-bold text-gray-700">DataFlow</span>
          </div>
          <div class="company-logo">
            <span class="text-2xl font-bold text-gray-700">InnovateLabs</span>
          </div>
          <div class="company-logo">
            <span class="text-2xl font-bold text-gray-700">StartupX</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .btn-primary-large {
    @apply bg-primary-600 text-white px-8 py-4 rounded-lg hover:bg-primary-700 transition-all font-medium text-lg inline-flex items-center hover:shadow-lg hover:scale-105;
  }
  
  .btn-secondary-large {
    @apply border-2 border-gray-300 text-gray-700 px-8 py-4 rounded-lg hover:border-primary-600 hover:text-primary-600 transition-all font-medium text-lg inline-flex items-center hover:shadow-lg;
  }
  
  .company-logo {
    @apply hover:opacity-100 transition-opacity cursor-pointer;
  }
</style>