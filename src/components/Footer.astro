---
import { Github, Linkedin, Mail, Twitter } from 'lucide-react';
---

<footer class="bg-gray-900 text-white py-16">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <h3 class="text-2xl font-bold mb-4">Vivek G Sindagi</h3>
        <p class="text-gray-400 mb-6 max-w-md">
          Software Developer & Data Engineer passionate about building scalable systems and meaningful user experiences.
        </p>
        <div class="flex space-x-4">
          <a href="mailto:alex.chen@email.com" class="social-link">
            <Mail className="w-5 h-5" />
          </a>
          <a href="https://linkedin.com/in/alexchen" class="social-link">
            <Linkedin className="w-5 h-5" />
          </a>
          <a href="https://github.com/alexchen" class="social-link">
            <Github className="w-5 h-5" />
          </a>
          <a href="https://twitter.com/alexchen" class="social-link">
            <Twitter className="w-5 h-5" />
          </a>
        </div>
      </div>
      
      <div>
        <h4 class="font-semibold mb-4">Quick Links</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/projects" class="hover:text-white transition-colors">Projects</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Blog</a></li>
          <li><a href="/resume" class="hover:text-white transition-colors">Resume</a></li>
        </ul>
      </div>
      
      <div>
        <h4 class="font-semibold mb-4">Contact</h4>
        <ul class="space-y-2 text-gray-400">
          <li>alex.chen@email.com</li>
          <li>Bengaluru, India</li>
          <li><a href="/contact" class="hover:text-white transition-colors">Get in Touch</a></li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-gray-800 mt-12 pt-8 text-center text-gray-400">
      <p>&copy; 2025 Vivek G Sindagi. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .social-link {
    @apply text-gray-400 hover:text-white transition-colors p-2 rounded-lg hover:bg-gray-800;
  }
</style>